{
  "name": "forge.timers",
  "version": "1.1.0",
  "description": "Persists $setTimeout/$setInterval timers to disk and restores them on restart.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc && node --test \"dist/__tests__/*.test.js\"",
    "docgen": "tsc && typedoc src/index.ts && node dist/docgen",
    "commit": "npm run docgen && node dist/commit",
    "prepublishOnly": "rimraf dist && npm run build"
  },
  "keywords": [
    "forgescript",
    "forge.timers",
    "forgetimers",
    "discord",
    "discord.js",
    "timers",
    "setTimeout",
    "setInterval",
    "persistence",
    "tryforge",
    "scheduler",
    "bdfd",
    "aoi.js",
    "aoi",
    "dbd",
    "dbd.ts",
    "dbd.js",
    "bdscript"
  ],
  "author": {
    "name": "Daaisukidayo",
    "url": "https://github.com/Daaisukidayo/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daaisukidayo/ForgeTimers.git"
  },
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@tryforge/forge.db": ">=2.1.1",
    "@tryforge/forgescript": ">=2.7.0"
  },
  "devDependencies": {
    "@tryforge/forge.db": "^2.1.1",
    "@tryforge/forgescript": "github:tryforge/ForgeScript#dev",
    "@types/node": "^26.2.0",
    "better-sqlite3": "^12.11.1",
    "mongodb": "^6.21.0",
    "mysql2": "^3.24.2",
    "pg": "^8.23.0",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27"
  },
  "overrides": {
    "typeorm": "^0.3.27"
  }
}
